# מתוך Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# אופציונלי, רק לעבודה מקומית (npm run dev) בלי התחברות. אין להגדיר ב-Vercel.
# AUTH_DISABLED=true
# SUPABASE_SECRET_KEY=sb_secret_...

# SUMIT (קבלות): API > מפתחות API ב-SUMIT. המפתח הפרטי, לא הציבורי. לשים גם ב-Vercel
SUMIT_COMPANY_ID=
SUMIT_API_KEY=

# שליחת אישורי קבלה במייל (Gmail של העסק): Google Account > Security > App passwords.
# סיסמת אפליקציה, לא הסיסמה הרגילה. לשים גם ב-Vercel
SMTP_USER=negina998877@gmail.com
SMTP_PASS=
